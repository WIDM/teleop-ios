    "CFBundleDisplayName": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Teleop"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Teleop"
          }
        }
      }
    },
    "NSCameraUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The camera tracks the phone pose and detects volume-key hold and release."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "相機用來追蹤手機姿態，並偵測按住與放開音量鍵。"
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app connects to the teleop server on your network."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "App 需要連到你網路上的遙操作伺服器。"
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The microphone recognizes your chosen movement axis on this device. Audio is not saved."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "麥克風用來在裝置上辨識你選擇的移動方向，不儲存錄音。"
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Speech recognition selects height, forward/back, or left/right. Movement still requires holding volume up."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "語音辨識用來選擇高度、前後或左右，移動仍須按住上音量鍵。"
          }
        }
      }
    }
  },
  "sourceLanguage": "en",
  "version": "1.0"
}
