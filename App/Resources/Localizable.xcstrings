          "stringUnit": {
            "state": "translated",
            "value": "傾斜中"
          }
        }
      }
    },
    "state.turning": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turning"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "轉腕中"
          }
        }
      }
    },
    "state.wait": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wait"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請稍等"
          }
        }
      }
    },
    "stop.cause_arm_behind": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The robot stopped itself: the arm fell more than 10 cm behind the phone. Move slower."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "機器人自己急停：手臂落後手機超過 10 公分。請放慢移動。"
          }
        }
      }
    },
    "stop.cause_button": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You pressed STOP."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你按了急停。"
          }
        }
      }
    },
    "stop.cause_on_connect": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The robot was already stopped when the app connected, usually after a dropped connection."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連上時機器人已經在急停，通常是先前連線中斷造成的。"
          }
        }
      }
    },
    "stop.cause_server": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The robot stopped itself (%@)."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "機器人自己急停（%@）。"
          }
        }
      }
    },
    "stop.label": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "STOP"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "停止"
          }
        }
      }
    },
    "tutorial.buttons.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold an arrow: the arm moves that way. Hold Open or Close: the jaws open or close."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按住箭頭：手臂往那個方向移動。按住「打開」或「夾緊」：夾爪就打開或夾緊。"
          }
        }
      }
    },
    "tutorial.buttons.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold a button"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按住按鈕"
          }
        }
      }
    },
    "tutorial.cue.alarm": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A long rattle: emergency stop. You will always hear why."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一長串急震：急停。你一定會聽到原因。"
          }
        }
      }
    },
    "tutorial.cue.dead": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Three quick ticks: that press did nothing. Listen for why."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "快速三下：這一下沒作用，聽它說原因。"
          }
        }
      }
    },
    "tutorial.cue.end": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One long buzz: as far as it goes."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "長震一下：到底了。"
          }
        }
      }
    },
    "tutorial.cue.go": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One tick: the arm follows. Wait for it, then move."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輕點一下：手臂開始跟著你。等它出現再動。"
          }
        }
      }
    },
    "tutorial.cue.grip": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Two heavy thumps: the jaws have something. Let go of close."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重重兩下：夾到東西了，放開夾緊。"
          }
        }
      }
    },
    "tutorial.cue.letgo": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Two long buzzes: the phone let go for you. Release and press again."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "長震兩下：手機替你放開了，放開再按。"
          }
        }
      }
    },
    "tutorial.cue.reset": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold the top edge for 2 seconds: reset."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按住螢幕頂端兩秒：重置。"
          }
        }
      }
    },
    "tutorial.cue.stop": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bottom edge of the screen: emergency stop."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "螢幕底部：急停。"
          }
        }
      }
    },
    "tutorial.cues.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop, reset, and what you feel"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "急停、重置和震動的意思"
          }
        }
      }
    },
    "tutorial.hold_rule": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing moves unless you hold something. Let go and it stops where it is."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒按著就不會動。放開就停在原地。"
          }
        }
      }
    },
    "tutorial.keys.a": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold the upper volume key: the arm follows the phone. Hold the lower key: the jaws close."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按住上面的音量鍵：手臂跟著手機移動。按住下面的音量鍵：夾爪夾緊。"
          }
        }
      }
    },
    "tutorial.keys.b": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold the upper volume key: the arm follows the phone. Hold the lower key and turn the phone: the wrist turns."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按住上面的音量鍵：手臂跟著手機移動。按住下面的音量鍵再轉手機：手腕跟著轉。"
          }
        }
      }
    },
    "tutorial.keys.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The two keys"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "兩個音量鍵"
          }
        }
      }
    },
    "tutorial.speed.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fine moves slowly, for the last centimetres. Coarse moves faster. Switch only while nothing is held."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "細調走得慢，用在最後幾公分。粗調走得快。只有在沒按著任何東西時才能切換。"
          }
        }
      }
    },
    "tutorial.speed.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fine and Coarse"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "細調和粗調"
          }
        }
      }
    },
    "tutorial.step_of": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Step %lld of 3"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "第 %lld 步，共 3 步"
          }
        }
      }
    },
    "tutorial.thumb.a_open": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Slide your thumb up the screen and keep it there: the jaws open."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拇指在螢幕上往上滑，然後停著不放：夾爪打開。"
          }
        }
      }
    },
    "tutorial.thumb.a_turn": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Thumb on the screen, then turn the phone like a steering wheel: the jaws turn. Tip its top away or toward you: they tilt down or up."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拇指按在螢幕上，再像轉方向盤一樣轉手機：夾爪跟著轉。手機上緣往前或往後傾：夾爪往下或往上傾。"
          }
        }
      }
    },
    "tutorial.thumb.b_halves": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold the half under your thumb: the jaws close. Hold the other half: they open."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按住拇指下面那一半：夾爪夾緊。按住另一半：夾爪打開。"
          }
        }
      }
    },
    "tutorial.thumb.b_turn": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold the lower key and turn the phone like a steering wheel: the jaws turn. Tip its top away or toward you: they tilt."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按住下面的音量鍵，像轉方向盤一樣轉手機：夾爪跟著轉。手機上緣往前或往後傾：夾爪跟著傾斜。"
          }
        }
      }
    },
    "tutorial.thumb.title_a": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Thumb and turn"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拇指加轉手機"
          }
        }
      }
    },
    "tutorial.thumb.title_b": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The two halves of the screen"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "螢幕的左右兩半"
          }
        }
      }
    }
  },
  "sourceLanguage": "en",
  "version": "1.0"
}
