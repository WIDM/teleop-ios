  "strings": {
    "app.name": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Teleop"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Teleop"
          }
        }
      }
    },
    "base.volume_hint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold vol+: move the arm\nHold vol−: close. Left edge: open\nHold right edge: move the base"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按住音量＋：移動手臂\n按住音量－：夾爪關。左側：夾爪開\n按住右側邊緣：移動底座"
          }
        }
      }
    },
    "cloud.enter_standby": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter standby"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "進入待命"
          }
        }
      }
    },
    "cloud.fail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fail"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未通過"
          }
        }
      }
    },
    "cloud.fail_help": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check the robot power and network, or ask someone on site to check the e-stop."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請檢查機器人的電源與網路，或請現場人員確認急停按鈕。"
          }
        }
      }
    },
    "cloud.failed_hint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One check failed. Standby is locked."
