          "stringUnit": {
            "state": "translated",
            "value": "The robot was already stopped when the app connected, usually after a dropped connection."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連上時機器人已經在急停，通常是先前連線中斷造成的。"
          }
        }
      }
    },
    "stop.cause_server": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The robot stopped itself (%@)."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "機器人自己急停（%@）。"
          }
        }
      }
    },
    "stop.inputs_ignored": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Volume keys and on-screen controls are ignored."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "音量鍵和螢幕操作都會被忽略。"
          }
        }
      }
    },
    "stop.label": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "STOP"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "停止"
          }
        }
      }
    },
    "stop.locked": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Arm stopped. All inputs are locked."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "手臂已停止，所有輸入都已鎖定。"
          }
        }
      }
    },
    "stop.release_hint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Release early to cancel. A short buzz confirms release."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "提早放開就取消。短震一下代表已解除。"
          }
        }
      }
    },
    "stop.release_hold": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold 1s to release"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按住 1 秒解除"
          }
        }
      }
    },
    "tutorial.step_of": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Step %lld of 3"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "第 %lld 步，共 3 步"
          }
        }
      }
    },
    "tutorial.t1.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The arm follows your phone only while the button is held. Release to stop."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只有按住按鍵時，手臂才會跟著手機動。放開就停止。"
          }
        }
      }
    },
    "tutorial.t1.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold volume up to move the arm"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按住音量＋移動手臂"
          }
        }
      }
    },
    "tutorial.t2.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It moves only while held. Hold the left edge of the screen to open. One short pulse means closing, two mean opening."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按住才會動，放開就停。按住畫面左側邊緣是打開。短震 1 下代表正在關，短震 2 下代表正在開。"
          }
        }
      }
    },
    "tutorial.t2.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold volume down to close the gripper"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按住音量－關閉夾爪"
          }
        }
      }
    },
    "tutorial.t3.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap it at any time to stop the robot at once."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "隨時按下，機器人就會立刻停止。"
          }
        }
      }
    },
    "tutorial.t3.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The red STOP button is always here"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "紅色的停止按鈕一直都在這裡"
          }
        }
      }
    }
  },
  "sourceLanguage": "en",
  "version": "1.0"
}
