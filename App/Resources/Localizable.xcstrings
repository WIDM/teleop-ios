    "mode.cloud_desc": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect remotely. Two safety checks must pass first: robot heartbeat and physical e-stop."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "遠端連線。須先通過兩項安全檢查：機器人心跳與實體急停。"
          }
        }
      }
    },
    "mode.hint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick once per launch. You can change it in Settings."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
