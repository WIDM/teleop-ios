        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold 1s to release"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按住 1 秒解除"
          }
        }
      }
    },
    "tutorial.step_of": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Step %lld of 3"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "第 %lld 步，共 3 步"
          }
        }
      }
    },
    "tutorial.t1.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The arm follows your phone only while the button is held. Release to stop."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只有按住按鍵時，手臂才會跟著手機動。放開就停止。"
          }
        }
      }
    },
    "tutorial.t1.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold volume up to move the arm"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按住音量＋移動手臂"
          }
        }
      }
    },
    "tutorial.t2.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One short pulse means closed. Two short pulses mean opened."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "短震 1 下代表關閉，短震 2 下代表打開。"
          }
        }
      }
    },
    "tutorial.t2.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Press volume down for the gripper"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按音量－控制夾爪"
          }
        }
      }
    },
    "tutorial.t3.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap it at any time to stop the robot at once."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "隨時按下，機器人就會立刻停止。"
          }
        }
      }
    },
    "tutorial.t3.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The red STOP button is always here"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "紅色的停止按鈕一直都在這裡"
          }
        }
      }
    }
