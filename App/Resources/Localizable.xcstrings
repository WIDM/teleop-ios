    },
    "stop.release_hint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Release early to cancel. A short buzz confirms release."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "提早放開就取消。短震一下代表已解除。"
          }
        }
      }
    },
