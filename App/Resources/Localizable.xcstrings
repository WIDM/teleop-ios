    "base.volume_hint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold vol+: move the arm\nPress vol−: toggle gripper\nHold right edge: move the base"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按住音量＋：移動手臂\n按音量－：切換夾爪\n按住右側邊緣：移動底座"
          }
        }
      }
    },
