#!/bin/sh
# Check branch names and every outgoing commit before push.
# Enable once per clone: git config core.hooksPath .githooks
root=$(git rev-parse --show-toplevel) || exit 1
check="$root/scripts/check-git-hygiene.py"
zero=0000000000000000000000000000000000000000
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue   # branch deletion
  branch=${remote_ref#refs/heads/}
  python3 "$check" --branch "$branch" || status=1
  if [ "$remote_sha" = "$zero" ]; then
    commits=$(git rev-list "$local_sha" --not --remotes)
  else
    commits=$(git rev-list "$remote_sha..$local_sha")
  fi
  for c in $commits; do
    python3 "$check" --range "$c^!" || status=1
  done
done
exit $status
